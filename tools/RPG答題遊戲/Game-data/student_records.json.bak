    "details": [
      {
        "questionId": 103,
        "question": "台灣口訣「小紫點一邊、圓翅兩邊點、斯氏有三點、端紫亂亂點」，是用來辨識什麼？",
        "options": [
          "紫斑蝶四種近緣種辨識特徵",
          "不同年齡斑蝶的翅膀磨損",
          "斑蝶產卵的數量多寡",
          "蝴蝶幼蟲的斑紋分布"
        ],
        "studentAnswer": "紫斑蝶四種近緣種辨識特徵",
        "correctAnswer": "紫斑蝶四種近緣種辨識特徵",
        "isCorrect": true,
        "explanation": "這是辨識台灣常見四種紫斑蝶（小紫斑蝶、圓翅紫斑蝶、斯氏紫斑蝶、端紫斑蝶）前翅腹面斑紋的經典口訣。",
        "chapter": 1,
        "category": "斑蝶特徵"
      },
      {
        "questionId": 101,
        "question": "台灣哪一個地區以擁有世界罕見的數十萬隻紫斑蝶越冬聚集景象而聞名？",
        "options": [
          "新北陽明山",
          "花蓮太魯閣",
          "南投清境",
          "高雄茂林"
        ],
        "studentAnswer": "高雄茂林",
        "correctAnswer": "高雄茂林",
        "isCorrect": true,
        "explanation": "高雄市茂林區的「紫蝶幽谷」是世界級的越冬蝶谷，每年冬天吸引數十萬隻紫斑蝶南下避寒。",
        "chapter": 1,
        "category": "越冬生態"
      },
      {
        "questionId": 105,
        "question": "紫斑蝶在動物界生物分類中，屬於哪一個目？",
        "options": [
          "鞘翅目",
          "雙翅目",
          "鱗翅目",
          "膜翅目"
        ],
        "studentAnswer": "鱗翅目",
        "correctAnswer": "鱗翅目",
        "isCorrect": true,
        "explanation": "蝴蝶與蛾類全身披覆微細鱗片，在昆蟲綱中屬於「鱗翅目 (Lepidoptera)」。",
        "chapter": 1,
        "category": "生物分類"
      }
    ]
  },
